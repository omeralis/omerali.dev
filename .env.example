# Existing STRAPI_URL remains supported; STRAPI_API_URL takes precedence.
STRAPI_API_URL=https://api.omerali.dev
STRAPI_API_TOKEN=
# Optional when uploads use a different public CDN origin.
STRAPI_MEDIA_ORIGIN=
SITE_URL=https://omerali.dev
# At least 32 random characters; use the same value in Strapi webhook headers.
STRAPI_WEBHOOK_SECRET=
